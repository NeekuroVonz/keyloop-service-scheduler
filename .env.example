# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection used by Prisma
# docker-compose default credentials — change for non-local environments
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public

# Booking retry policy for transient exclusion conflicts
BOOKING_MAX_RETRIES=3

# Docker API entrypoint only. Default false — never wipe data on restart.
# Opt-in demo fixtures: RUN_SEED=true
RUN_SEED=false
